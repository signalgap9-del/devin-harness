{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^exec$",
        "hooks": [
          {
            "type": "command",
            "command": "node ops/verify/agent-guard.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(edit|write|notebook_edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ops/verify/file-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ops/verify/agent-ledger.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
